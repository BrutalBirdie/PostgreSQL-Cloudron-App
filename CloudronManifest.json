{
  "id": "io.cloudron.custom.postgresql",
  "title": "PostgreSQL Server",
  "author": "PostgreSQL Global Development Group",
  "description": "file://DESCRIPTION.md",
  "tagline": "Standalone PostgreSQL server reachable from external hosts",
  "version": "1.5.2",
  "upstreamVersion": "18.6",
  "minBoxVersion": "10.0.1",
  "website": "https://www.postgresql.org/",
  "icon": "file://logo.png",
  "healthCheckPath": "/healthz",
  "configurePath": "/admin",
  "httpPort": 8000,
  "memoryLimit": 1073741824,
  "checklist": {
    "create-admin-group": {
      "message": "Set admins: add Cloudron usernames to PG_ADMINS or Cloudron groups to PG_ADMIN_GROUP in /app/data/env.sh. Restart the app after editing env.sh."
    }
  },
  "tcpPorts": {
    "POSTGRES_PORT": {
      "title": "PostgreSQL Port",
      "description": "Port for PostgreSQL client connections (TLS only)",
      "defaultValue": 5432,
      "containerPort": 5432
    }
  },
  "persistentDirs": [
    "/var/lib/postgresql"
  ],
  "backupCommand": "/app/pkg/backup.sh",
  "restoreCommand": "/app/pkg/restore.sh",
  "addons": {
    "localstorage": {},
    "tls": {},
    "oidc": {
      "loginRedirectUri": "/auth/callback",
      "logoutRedirectUri": "/",
      "tokenSignatureAlgorithm": "RS256"
    },
    "scim": {},
    "sendmail": {
      "requiresValidCertificate": true,
      "supportsDisplayName": true
    }
  },
  "tags": [
    "database"
  ],
  "changelog": "file://CHANGELOG",
  "postInstallMessage": "file://POSTINSTALL.md",
  "manifestVersion": 2,
  "iconUrl": "https://github.com/BrutalBirdie/PostgreSQL-Cloudron-App/blob/master/logo.png?raw=true",
  "packagerName": "James Smith",
  "packagerUrl": "https://git.cloudron.io/playground/postgresql-app",
  "mediaLinks": [
    "https://github.com/BrutalBirdie/PostgreSQL-Cloudron-App/blob/master/screenshots/databases.png?raw=true",
    "https://github.com/BrutalBirdie/PostgreSQL-Cloudron-App/blob/master/screenshots/database.png?raw=true",
    "https://github.com/BrutalBirdie/PostgreSQL-Cloudron-App/blob/master/screenshots/admin.png?raw=true",
    "https://github.com/BrutalBirdie/PostgreSQL-Cloudron-App/blob/master/screenshots/database-phone.png?raw=true"
  ],
  "contactEmail": "support@cloudron.io",
  "packageUrl": "https://git.cloudron.io/playground/postgresql-app"
}
