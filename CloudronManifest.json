{
  "id": "io.cloudron.custom.postgresql",
  "title": "PostgreSQL Server",
  "author": "PostgreSQL Global Development Group",
  "description": "file://DESCRIPTION.md",
  "tagline": "Standalone PostgreSQL server reachable from external hosts",
  "version": "1.0.0",
  "upstreamVersion": "18.6",
  "minBoxVersion": "9.2.0",
  "website": "https://www.postgresql.org/",
  "icon": "file://logo.png",
  "healthCheckPath": "/healthz",
  "configurePath": "/admin",
  "httpPort": 8000,
  "memoryLimit": 1073741824,
  "checklist": {
    "create-admin-group": {
      "message": "Set admins: add Cloudron usernames to PG_ADMINS in /app/data/env.sh, or add users to a Cloudron group named postgres-admins. Restart the app after editing env.sh."
    }
  },
  "tcpPorts": {
    "POSTGRES_PORT": {
      "title": "PostgreSQL Port",
      "description": "Port for PostgreSQL client connections (TLS only)",
      "defaultValue": 5432,
      "containerPort": 5432
    }
  },
  "persistentDirs": [
    "/var/lib/postgresql"
  ],
  "backupCommand": "/app/pkg/backup.sh",
  "restoreCommand": "/app/pkg/restore.sh",
  "addons": {
    "localstorage": {},
    "tls": {},
    "oidc": {
      "loginRedirectUri": "/auth/callback",
      "logoutRedirectUri": "/",
      "tokenSignatureAlgorithm": "RS256"
    },
    "scim": {}
  },
  "tags": [
    "database"
  ],
  "changelog": "file://CHANGELOG",
  "postInstallMessage": "file://POSTINSTALL.md",
  "manifestVersion": 2,
  "iconUrl": "https://git.cloudron.io/playground/postgresql-app/-/raw/master/logo.png",
  "packagerName": "Elias Hackradt",
  "packagerUrl": "https://git.cloudron.io/playground/postgresql-app",
  "mediaLinks": [
    "https://git.cloudron.io/playground/postgresql-app/-/raw/master/screenshots/databases.png",
    "https://git.cloudron.io/playground/postgresql-app/-/raw/master/screenshots/database.png",
    "https://git.cloudron.io/playground/postgresql-app/-/raw/master/screenshots/admin.png"
  ],
  "contactEmail": "elias@cloudron.io"
}
